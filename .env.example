# PS01 environment template — CLAUDE.md section 4.
# Copy to .env and fill in real values. .env is gitignored and must stay that way.
# No value here is a real secret.

# --- Storage -----------------------------------------------------------------
# Local development against the Compose database (published on loopback only).
DATABASE_URL=postgresql+psycopg://ps01:ps01_local_dev@127.0.0.1:5432/ps01
POSTGRES_USER=ps01
POSTGRES_PASSWORD=ps01_local_dev
POSTGRES_DB=ps01

# --- Web ---------------------------------------------------------------------
# The browser origin the app is served from. Used for cookie scope, CORS and the
# CSRF allowed-origin check, so it must match the address the browser actually uses.
#
# This default is the Compose stack, because that is the one that breaks if it is
# wrong: Caddy publishes on HTTP_PORT (8080 below) and the API would reject every
# login from that origin as a cross-site request. `npm run dev` on port 3000 keeps
# working regardless — while COOKIE_SECURE is false the API also accepts
# http://localhost:3000 and http://127.0.0.1:3000 automatically.
#
# Deployed behind a domain, set this to https://your-domain.example and set
# COOKIE_SECURE=true.
APP_ORIGIN=http://localhost:8080

# Caddy site address: ":80" for a local/LAN demo, or "your-domain.example" to get
# an automatic HTTPS certificate.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Sessions ----------------------------------------------------------------
# Generate a real one before deploying:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-before-deploying
SESSION_TTL_HOURS=12
# Bounded connect timeout so the API starts and reports a storage error instead of
# hanging when the database is unreachable.
DB_CONNECT_TIMEOUT_SECONDS=5
# Must be true on any HTTPS deployment. Leaving it false over HTTPS sends the
# session cookie insecurely.
COOKIE_SECURE=false

# --- Simulation --------------------------------------------------------------
SIM_TICK_SECONDS=1
FORECAST_INTERVAL_SECONDS=5

# --- Live AI investigator (Phase 7) ------------------------------------------
# The app is fully usable with AI_ENABLED=false: telemetry, rules, forecasts and
# manual recovery never depend on the provider.
AI_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_DAILY_CALL_LIMIT=30
LLM_MAX_OUTPUT_TOKENS=1200
AI_INCIDENT_COOLDOWN_SECONDS=120
AI_PENDING_QUEUE_LIMIT=10
AI_MAX_TOOL_CALLS=4
AI_MAX_PROVIDER_ATTEMPTS=3

# --- Optional ML (Phase 10) --------------------------------------------------
ANOMALY_MODEL_PATH=

# --- Frontend ----------------------------------------------------------------
# Where `npm run dev` proxies /api. Leave blank in the static export: the deployed
# frontend calls /api on its own origin through Caddy.
API_PROXY_TARGET=http://127.0.0.1:8000
